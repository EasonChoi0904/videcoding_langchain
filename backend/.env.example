# ==================== LangChain RAG 知识库问答系统 · 环境配置模板 ====================
# 使用方法:复制本文件为 .env,填入真实值后保存。

# ---- 阿里云百炼(必填:在 https://bailian.console.aliyun.com 控制台申请 Key)----
DASHSCOPE_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ---- 对话模型(OpenAI 兼容接口,默认质量/成本均衡档)----
CHAT_MODEL=qwen-plus
# 可选:qwen-turbo(更省) / qwen-max(更强) / qwen-flash(免费档,以控制台开放为准)

# ---- 向量模型(默认 1024 维,改动维度需重建向量集合)----
EMBEDDING_MODEL=text-embedding-v4
EMBEDDING_API_MODE=auto
# auto=优先 OpenAI 兼容接口,失败自动切原生接口;也可显式写 compatible / native

# ---- 重排模型 ----
RERANK_MODEL=qwen3-rerank
# 若不可用可换 gte-rerank / gte-rerank-v2(以控制台开放为准)

# ---- 安全(务必改为随机长字符串,可用任意在线密码生成器)----
SECRET_KEY=please-change-me-to-a-long-random-string

# ---- 覆盖默认检索参数(可选,管理端设置页亦可动态调整)----
# RERANK_THRESHOLD=0.45
# RERANK_TOP_N=5
# HYBRID_EACH_TOP_K=20
